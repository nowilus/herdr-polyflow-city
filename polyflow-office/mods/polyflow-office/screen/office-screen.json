{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "theme": "polyflow-neon",
  "background": "canvas",
  "terminal_padding": [
    8,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "office-scene",
      "type": "block",
      "window_drag": true,
      "content": {
        "mod": "polyflow-office",
        "props": {
          "screen": true
        }
      }
    },
    {
      "id": "office-chat-bottom",
      "type": "column",
      "size": {
        "px": 320
      },
      "min": 200,
      "resizable": false,
      "children": [
        {
          "id": "office-chat-bottom-bar",
          "type": "block",
          "size": { "px": 30 },
          "content": { "mod": "polyflow-office", "props": { "chatBar": "follow", "chatPlace": "screen" } }
        },
        {
          "id": "office-chat-bottom-body",
          "type": "stack",
          "active": "office-chat-bottom-chat",
          "children": [
            { "id": "office-chat-bottom-chat", "type": "block", "content": { "mod": "polyflow-office", "props": { "chatPlace": "screen" } } },
            { "id": "office-chat-bottom-terminal", "type": "block", "content": { "agent": "focused" } }
          ]
        }
      ]
    }
  ]
}
